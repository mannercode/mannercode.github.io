// For format details, see https://aka.ms/vscode-remote/devcontainer.json or this file's README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.122.1/containers/docker-existing-dockerfile
{
    "name": "${containerWorkspaceFolderBasename}",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "runArgs": [
        "--name=${localEnv:USER:unknown}-${localWorkspaceFolderBasename}"
    ],
    "remoteUser": "jekyll",
    "containerEnv": {
        "JEKYLL_BUILD_ONLY": "${localEnv:CI:false}"
    },
    "mounts": [
        "source=${localEnv:HOME}/.codex,target=/home/jekyll/.codex,type=bind",
        "source=${localEnv:HOME}/.config,target=/home/jekyll/.config,type=bind"
    ],
    "initializeCommand": {
        "prepare-mounts": "mkdir -p ${localEnv:HOME}/.codex ${localEnv:HOME}/.config"
    },
    "postCreateCommand": {
        "bundle": "bundle install"
    },
    "postStartCommand": {
        "plantuml": "nohup bash -c 'java -jar /opt/plantuml.jar -picoweb:5020 >/tmp/plantuml.log &' >/dev/null",
        "run": "if [ \"$JEKYLL_BUILD_ONLY\" != true ]; then nohup bash -c 'bundle exec jekyll serve --future --port 4000 --livereload --livereload-port 4001 >/tmp/jekyll.log &' >/dev/null; fi",
        "echo": "if [ \"$JEKYLL_BUILD_ONLY\" != true ]; then echo '✅ Jekyll server started: http://localhost:4000'; fi"
    },
    "forwardPorts": [
        4000,
        4001,
        5020
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "jebbs.plantuml",
                "davidanson.vscode-markdownlint",
                "mkhl.shfmt",
                "esbenp.prettier-vscode"
            ]
        }
    }
}
