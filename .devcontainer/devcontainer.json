// For format details, see https://aka.ms/vscode-remote/devcontainer.json or this file's README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.122.1/containers/docker-existing-dockerfile
{
    "name": "${containerWorkspaceFolderBasename}",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "runArgs": [
        "--name=${localEnv:USER:unknown}-${localWorkspaceFolderBasename}"
    ],
    "remoteUser": "jekyll",
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/jekyll/.claude,type=bind",
        "source=${localEnv:HOME}/.claude.json,target=/home/jekyll/.claude.json,type=bind"
    ],
    "initializeCommand": {
        "prepare-mounts": "mkdir -p ${localEnv:HOME}/.claude",
        "prepare-files": "touch ${localEnv:HOME}/.claude.json"
    },
    "postCreateCommand": {
        "bundle": "bundle install"
    },
    "postStartCommand": {
        "plantuml": "nohup bash -c 'java -jar /opt/plantuml.jar -picoweb:5020 >/tmp/plantuml.log &' >/dev/null",
        "run": "nohup bash -c 'bundle exec jekyll serve --future --port 4000 --livereload --livereload-port 4001 &' >/tmp/jekyll.log && echo '✅ Jekyll server started: http://localhost:4000'"
    },
    "forwardPorts": [
        4000,
        4001
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "jebbs.plantuml",
                "davidanson.vscode-markdownlint",
                "mkhl.shfmt",
                "esbenp.prettier-vscode",
                "anthropic.claude-code"
            ],
            "settings": {
                "files.watcherExclude": {
                    "**/.git/objects/**": true,
                    "**/.git/subtree-cache/**": true,
                    "**/uml/**": true,
                    "**/_site/**": true
                },
                "search.exclude": {
                    "**/node_modules/**": true,
                    "**/uml/**": true,
                    "**/_site/**": true
                },
                "files.exclude": {
                    "**/node_modules/**": true,
                    "**/uml/**": true,
                    "**/_site/**": true
                },
                "remote.downloadExtensionsLocally": true,
                "plantuml.server": "http://localhost:5020/",
                "plantuml.render": "PlantUMLServer",
                "[markdown]": {
                    "editor.defaultFormatter": "davidAnson.vscode-markdownlint"
                },
                "markdownlint.config": {
                    "default": true,
                    "MD032": false,
                    "MD033": false,
                    "MD036": false,
                    "MD037": false,
                    "MD045": false,
                    "MD046": false
                }
            }
        }
    }
}
