// For format details, see https://aka.ms/vscode-remote/devcontainer.json or this file's README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.122.1/containers/docker-existing-dockerfile
{
    "name": "${containerWorkspaceFolderBasename}",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "runArgs": [
        "--name=${localEnv:USER:unknown}-${localWorkspaceFolderBasename}"
    ],
    "remoteUser": "jekyll",
    "mounts": [
        "source=${localEnv:HOME}/.codex,target=/home/jekyll/.codex,type=bind"
    ],
    "initializeCommand": {
        "prepare-mounts": "mkdir -p ${localEnv:HOME}/.codex"
    },
    "postCreateCommand": {
        "bundle": "bundle install"
    },
    "postStartCommand": {
        "plantuml": "nohup bash -c 'java -jar /opt/plantuml.jar -picoweb:5020 >/tmp/plantuml.log &' >/dev/null"
    },
    "forwardPorts": [3030],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.live-server",
                "jebbs.plantuml",
                "davidanson.vscode-markdownlint",
                "mkhl.shfmt",
                "openai.chatgpt",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "files.watcherExclude": {
                    "**/.git/objects/**": true,
                    "**/.git/subtree-cache/**": true,
                    "**/uml/**": true,
                    "**/_site/**": true
                },
                "search.exclude": {
                    "**/node_modules/**": true,
                    "**/uml/**": true,
                    "**/_site/**": true
                },
                "files.exclude": {
                    "**/node_modules/**": true,
                    "**/uml/**": true,
                    "**/_site/**": true
                },
                "livePreview.portNumber": 3030,
                "remote.downloadExtensionsLocally": true,
                "plantuml.server": "http://localhost:5020/",
                "plantuml.render": "PlantUMLServer"
            }
        }
    }
}
